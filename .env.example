# ======================================================
# BloodConnect - Environment Configuration Example
# ======================================================

# XAMPP Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3305
DB_NAME=bloodconnect_db
DB_USER=root
DB_PASSWORD=

# Backend REST API URL
# For Chrome/Local testing:
API_BASE_URL=http://127.0.0.1/bloodconnect/backend
# For Android Emulator:
# API_BASE_URL=http://10.0.2.2/bloodconnect/backend
# For Physical Android Device on same Wi-Fi:
# API_BASE_URL=http://192.168.1.49/bloodconnect/backend

# Map Configuration (Google Maps)
MAP_TILE_PROVIDER=GoogleMaps
